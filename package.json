{
  "name": "vibe-debugger",
  "displayName": "Vibe Debugger",
  "description": "Helps beginners fix code errors by asking clarifying questions before fixing",
  "version": "0.1.1",
  "publisher": "RavikumarBadami",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ravi-Badami/vibe-debugger"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "debugging",
    "copilot",
    "beginner",
    "error-fixing",
    "javascript",
    "typescript",
    "education"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "images/icon.webp",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Debuggers",
    "Education"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "vibedebugger",
        "name": "Vibe Debugger",
        "description": "Asks clarifying questions before fixing errors",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "vibedebugger.runDemo",
        "title": "Run Demo",
        "category": "Vibe Debugger"
      }
    ],
    "configuration": {
      "title": "Vibe Debugger",
      "properties": {
        "vibedebugger.autoNotify": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic error notifications"
        },
        "vibedebugger.notificationDelay": {
          "type": "number",
          "default": 10,
          "description": "Delay in seconds before showing error notifications"
        },
        "vibedebugger.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode for additional logging"
        },
        "vibedebugger.maxNotificationsPerHour": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of notifications per hour"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package-vsix": "vsce package",
    "publish": "vsce publish",
    "prepublishOnly": "npm run test && npm run lint"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vsce": "^2.15.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}

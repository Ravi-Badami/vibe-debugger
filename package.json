{
  "name": "vibe-debugger",
  "displayName": "Vibe Debugger",
  "description": "Helps beginners fix code errors by asking clarifying questions before fixing",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibe-debugger.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "Vibe Debugger",
      "properties": {
        "vibedebugger.autoNotify": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic error notifications"
        },
        "vibedebugger.notificationDelay": {
          "type": "number",
          "default": 10,
          "description": "Delay in seconds before showing error notifications"
        },
        "vibedebugger.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode for additional logging"
        },
        "vibedebugger.maxNotificationsPerHour": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of notifications per hour"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
